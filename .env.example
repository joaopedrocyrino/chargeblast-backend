# Copy to `.env` for running the API natively (outside Docker).
# All variables are validated at start-up (see src/config/app-config.ts).

NODE_ENV=development
# HTTP port the API listens on.
PORT=4000
# PostgreSQL connection string. The infra stack publishes Postgres on 5433.
DATABASE_URL=postgres://chargeblast:chargeblast_local_password@localhost:5433/chargeblast
# Separate database used by `npm run test:integration` (it is wiped on every run).
DATABASE_URL_TEST=postgres://chargeblast:chargeblast_local_password@localhost:5433/chargeblast_test
# Maximum pooled PostgreSQL connections.
DB_POOL_MAX=10
# Comma-separated list of origins allowed by CORS. Leave empty when the API is
# served from the same origin as the frontend (the default behind the proxy).
CORS_ORIGIN=http://localhost:3000
# Run migrations + idempotent seed when the dev container starts.
SEED_ON_START=true
# Most rows the payments table may hold before POST /payments is refused
# (the public demo has no accounts, so this keeps it from growing forever).
PAYMENT_CREATE_LIMIT=3000
